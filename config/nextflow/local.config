/*
 * Local workstation overlay: local executor and modest resource caps.
 * container_profile apptainer -> nf-core -profile singularity (see bin/run_cohort.sh nf_profile).
 * container_profile docker    -> nf-core -profile docker; singularity { enabled = false } below.
 *
 * Security: pinned pipeline revisions come from config/pin.yaml (-r on the CLI).
 * Apptainer: run as invoking user, minimal mounts (--containall --no-home). No --privileged.
 * Docker: avoid privileged runs; prefer read-only binds where nf-core/process allows.
 */

executor {
  name = 'local'
}

process {
  cpus = 4
  memory = 8.GB
  maxForks = 2
}

singularity {
  enabled = true
  autoMounts = false
  // Apptainer/Singularity: non-root, contained filesystem (adjust if a pipeline needs extra binds).
  runOptions = '-u --containall --no-home'
}

// If container_profile is docker, nf-core -profile docker enables Docker; add non-root runOptions there:
// docker.runOptions = '-u $(id -u):$(id -g)'
